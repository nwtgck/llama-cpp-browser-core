+// Browser WebGPU does not implement GROUP_NORM directly. For contiguous
+// channel-divisible F32 tensors, each group is one row of the existing NORM.
+// Retain upstream GROUP_NORM (and CPU fallback) for every other shape/type.
+static ggml_tensor* sd_browser_group_norm(ggml_context* ctx, ggml_tensor* x,
+                                          int groups, float eps) {
+#ifdef SD_BROWSER_WEBGPU
+    if (groups > 0 && x->type == GGML_TYPE_F32 && ggml_is_contiguous(x) &&
+        x->ne[2] % groups == 0) {
+        auto rows = ggml_reshape_2d(ctx, x,
+            x->ne[0] * x->ne[1] * (x->ne[2] / groups), groups * x->ne[3]);
+        auto normalized = ggml_norm(ctx, rows, eps);
+        return ggml_reshape_4d(ctx, normalized, x->ne[0], x->ne[1], x->ne[2], x->ne[3]);
+    }
+#endif
+    return ggml_group_norm(ctx, x, groups, eps);
+}
+
